{
  "manifest_version": 3,
  "name": "Searchbox",
  "version": "0.1.0",
  "description": "把 JSON 搜索 API 变成你自己的搜索结果页",
  "key": "",
  "permissions": ["storage", "favicon", "tabs"],
  "host_permissions": ["https://api.anysearch.com/*"],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "src/bg.js",
    "type": "module"
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["_favicon/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
